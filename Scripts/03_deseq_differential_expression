# =============================================================================
# Script 03: DESeq2 Differential Expression Analysis
# =============================================================================
# WHAT: Run the full DESeq2 pipeline on the prepared Breast Cancer count data:
#       (1) construct a DESeqDataSet with design formula (~ condition),
#       (2) estimate size factors, dispersions, and fit the NB GLM,
#       (3) test for differential expression (Wald test),
#       (4) apply log-fold-change shrinkage (apeglm),
#       (5) export results tables (full, shrunk, normalized, significant).
#
# WHY:  DESeq2 models RNA-seq counts with a negative binomial distribution,
#       accounting for the mean-variance relationship inherent to count data.
#       The design formula (~ condition) tests for expression differences between
#       primary breast tumor tissue and non-tumor control tissue. LFC shrinkage 
#       (apeglm) produces stable effect-size estimates for ranking and visualization.
#
# BIOLOGICAL CONTEXT:
#   This analysis identifies genes whose expression changes specifically in
#   breast cancer tumor tissue relative to normal breast tissue. The resulting
#   gene list provides insight into deregulated oncogenic pathways and forms 
#   the foundation for downstream functional enrichment and network analyses.
#
# KEY TEACHING POINTS:
#   - Size factor normalization (median-of-ratios)
#   - Negative binomial model and dispersion estimation
#   - Wald test for significance
#   - LFC shrinkage (apeglm) for stable effect sizes
#   - padj (BH-adjusted) vs. raw pvalue
#   - Independent filtering (removes low-count genes from testing)
# =============================================================================

suppressPackageStartupMessages({
  library(DESeq2)
  library(apeglm)
})

# ---- Setup Directories ------------------------------------------------------
data_dir   <- "data"
tables_dir <- "tables"

if (!dir.exists(tables_dir)) dir.create(tables_dir, recursive = TRUE)

# ---- Load processed data from Script 01 & 02 --------------------------------
counts   <- readRDS(file.path(data_dir, "counts_filtered.rds"))
metadata <- readRDS(file.path(data_dir, "metadata.rds"))

# Safety check: Remove NA rows if any exist in the count matrix
if (any(is.na(counts))) {
  counts <- counts[complete.cases(counts), ]
}

# ---- Step 1: Construct DESeqDataSet ----------------------------------------
# WHAT: Create a DESeqDataSet object from the count matrix and metadata.
#       The design formula ~ condition specifies:
#         - condition: the primary variable of interest (tumor vs. normal)
# WHY:  The design formula defines the model framework. Setting normal as the 
#       reference level ensures that positive log2FoldChange values correspond 
#       to up-regulation in tumor tissue.
dds <- DESeqDataSetFromMatrix(
  countData = counts,
  colData   = metadata,
  design    = ~ condition
)

# Ensure condition reference level is "normal" (positive LFC = up in tumor)
dds$condition <- relevel(dds$condition, ref = "normal")

# ---- Step 2: Run DESeq2 pipeline -------------------------------------------
# WHAT: The DESeq() function runs three core steps in sequence:
#       (a) estimateSizeFactors(): median-of-ratios normalization
#           - computes size factors correcting for sequencing depth differences
#       (b) estimateDispersions(): fits the mean-dispersion relationship
#           - shrinks gene-wise dispersion estimates toward the fitted trend
#       (c) nbinomWaldTest(): fits the NB GLM and computes Wald statistics
#           - tests H0: log2FC = 0 for the tumor vs. normal contrast
# WHY:  The negative binomial distribution models overdispersion characteristic 
#       of RNA-seq count data. Dispersion shrinkage borrows strength across 
#       genes to stabilize estimates.
dds <- DESeq(dds)

# Report size factors (normalization)
sf <- sizeFactors(dds)
cat("    Size Factors Range:", round(min(sf), 3), "-", round(max(sf), 3), "\n")
cat("    Size Factors Median:", round(median(sf), 3), "\n")

# ---- Step 3: Extract results ------------------------------------------------
# WHAT: Extract the results table for the condition contrast (tumor vs normal).
# WHY:  The contrast explicitly defines comparison direction: tumor vs. normal.
#       The output table provides baseMean, log2FoldChange, lfcSE, stat, pvalue,
#       and BH-adjusted p-value (padj).
res <- results(dds, contrast = c("condition", "tumor", "normal"), alpha = 0.05)

# Summary of results
cat("\n--- Differential Expression Summary ---\n")
cat("    Total genes tested:", sum(!is.na(res$pvalue)), "\n")
cat("    Upregulated (padj < 0.05, log2FC > 0):",
    sum(res$padj < 0.05 & res$log2FoldChange > 0, na.rm = TRUE), "\n")
cat("    Downregulated (padj < 0.05, log2FC < 0):",
    sum(res$padj < 0.05 & res$log2FoldChange < 0, na.rm = TRUE), "\n")
cat("    Total significant (padj < 0.05):",
    sum(res$padj < 0.05, na.rm = TRUE), "\n")

# ---- Step 4: Log-fold-change shrinkage -------------------------------------
# WHAT: Apply LFC shrinkage using the apeglm method to shrink noisy log2FC 
#       estimates toward zero (especially for low-count genes).
# WHY:  Unshrunk log2FC can produce artificially inflated values for low-count 
#       genes due to sampling noise. apeglm shrinkage stabilizes effect sizes 
#       for MA plots, Volcano plots, and gene ranking.
cat("\nAvailable coefficients:", paste(resultsNames(dds), collapse = ", "), "\n")
coef_name <- "condition_tumor_vs_normal"

if (coef_name %in% resultsNames(dds)) {
  res_shrunk <- lfcShrink(dds, coef = coef_name, res = res, type = "apeglm")
} else {
  res_shrunk <- lfcShrink(dds, contrast = c("condition", "tumor", "normal"), type = "normal")
}

# ---- Step 5: Export results -------------------------------------------------
# WHAT: Save full results, shrunk results, normalized counts, and significant 
#       gene tables for downstream scripts.

# 5a. Full results (unshrunk)
res_df <- as.data.frame(res)
res_df$gene_id <- rownames(res_df)
res_df <- res_df[, c("gene_id", "baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj")]
write.csv(res_df, file.path(tables_dir, "deseq2_results.csv"), row.names = FALSE)

# 5b. Shrunk results
res_shrunk_df <- as.data.frame(res_shrunk)
res_shrunk_df$gene_id <- rownames(res_shrunk_df)
cols_present <- intersect(c("gene_id", "baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj"),
                          colnames(res_shrunk_df))
res_shrunk_df <- res_shrunk_df[, cols_present]
write.csv(res_shrunk_df, file.path(tables_dir, "deseq2_results_shrunk.csv"), row.names = FALSE)

# 5c. Normalized counts
norm_counts <- counts(dds, normalized = TRUE)
write.csv(norm_counts, file.path(tables_dir, "deseq2_normalized_counts.csv"))

# 5d. Significant genes (padj < 0.05, |log2FC| >= 1)
sig_genes <- res_shrunk_df[which(res_shrunk_df$padj < 0.05 & abs(res_shrunk_df$log2FoldChange) >= 1), ]
sig_genes <- sig_genes[order(sig_genes$padj), ]
write.csv(sig_genes, file.path(tables_dir, "deseq2_significant_genes.csv"), row.names = FALSE)

# 5e. Save RDS objects for downstream scripts
saveRDS(dds, file.path(data_dir, "dds_object.rds"))
saveRDS(res, file.path(data_dir, "deseq2_res.rds"))
saveRDS(res_shrunk, file.path(data_dir, "deseq2_res_shrunk.rds"))

cat("\n=============================================================================\n")
cat("Script 03 Complete! Output files saved to 'data/' and 'tables/'.\n")
cat("=============================================================================\n")